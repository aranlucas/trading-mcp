{
  "name": "trading-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trading tools monorepo - MCP server, screener API, and shared utilities",
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@trading/mcp",
    "dev:screener": "turbo run dev --filter=@trading/screener",
    "clean": "turbo run clean && rm -rf node_modules",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint packages/*/src",
    "lint:fix": "oxlint packages/*/src --fix",
    "format": "oxfmt packages/*/src",
    "format:check": "oxfmt --check packages/*/src",
    "secretlint": "git ls-files -z | xargs -0 secretlint",
    "syncpack:list": "syncpack list-mismatches",
    "syncpack:fix": "syncpack fix-mismatches",
    "syncpack:lint": "syncpack lint",
    "prepare": "husky"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "secretlint": "^13.0.5",
    "syncpack": "^15.3.3",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "lint-staged": {
    "packages/*/src/**/*.ts": [
      "oxlint --fix",
      "oxfmt"
    ]
  }
}
