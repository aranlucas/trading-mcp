{
  "name": "trading-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Trading tools monorepo - MCP server, screener API, and shared utilities",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @trading/mcp dev",
    "dev:screener": "pnpm --filter @trading/screener dev",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "typecheck": "pnpm build && pnpm -r typecheck && tsc -p tsconfig.tests.json",
    "test": "pnpm build && pnpm -r test",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt packages/*/src",
    "format:check": "oxfmt --check packages/*/src",
    "secretlint": "git ls-files -z | xargs -0 secretlint",
    "syncpack:list": "syncpack list",
    "syncpack:fix": "syncpack fix",
    "syncpack:lint": "syncpack lint",
    "prepare": "husky",
    "test:providers": "pnpm --filter @trading/core build && RUN_REAL_PROVIDER_TESTS=1 pnpm --filter @trading/screener exec vitest run src/__tests__/backtest-real.test.ts",
    "test:deployment": "RUN_DEPLOYMENT_E2E=1 vitest run --config vitest.vercel.config.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.87.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@vitest/coverage-v8": "^5.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "1.87.0",
    "portless": "0.15.7",
    "secretlint": "^13.0.7",
    "syncpack": "^15.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "lint-staged": {
    "packages/*/src/**/*.ts": [
      "oxlint --fix",
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.10.1"
}
