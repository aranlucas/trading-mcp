{
  "name": "@trading/screener",
  "version": "0.1.0",
  "description": "Stock screener API service - deployable to Vercel",
  "keywords": [
    "api",
    "screener",
    "stocks",
    "trading",
    "vercel"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./services/screener": {
      "types": "./dist/services/screener.d.ts",
      "import": "./dist/services/screener.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "portless run --name screener.trading-mcp tsx src/index.ts",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "@trading/core": "workspace:*",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
