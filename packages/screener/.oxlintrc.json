{
  "extends": ["../../.oxlintrc.json"],
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "env": {
    "node": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/.expo/**",
    "**/.vercel/**",
    "**/.agent/**",
    "**/.agents/**",
    "**/.claude/**",
    "**/.codex/**",
    "**/.continue/**",
    "**/.cursor/**",
    "**/.gemini/**",
    "**/.opencode/**",
    "**/.pi/**",
    "**/.roo/**",
    "**/.windsurf/**"
  ],
  "overrides": [
    {
      "files": ["src/index.ts"],
      "rules": {
        "eslint/no-console": [
          "error",
          {
            "allow": ["log"]
          }
        ]
      }
    },
    {
      "files": ["src/scripts/run-backtest.ts"],
      "rules": {
        "eslint/no-console": [
          "error",
          {
            "allow": ["error", "log"]
          }
        ]
      }
    },
    {
      "files": ["src/scripts/telegram-screener.ts"],
      "rules": {
        "eslint/no-console": [
          "error",
          {
            "allow": ["error", "log"]
          }
        ]
      }
    },
    {
      "files": [
        "src/scripts/run-backtest.ts",
        "test/market-data.test.ts",
        "test/screener.service.test.ts"
      ],
      "rules": {
        "typescript/no-non-null-assertion": "off"
      }
    }
  ]
}
