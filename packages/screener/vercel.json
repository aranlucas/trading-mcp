{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "cd ../.. && pnpm --filter @trading/core build && pnpm --filter @trading/screener build",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "framework": null,
  "functions": {
    "api/[[...path]].ts": {
      "runtime": "@vercel/node@3.0.0"
    }
  }
}
