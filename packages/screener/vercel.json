{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "corepack pnpm --filter @trading/core build && corepack pnpm --filter @trading/screener build",
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "outputDirectory": ".",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    },
    "api/[...path].ts": {
      "maxDuration": 30
    }
  },
  "env": {
    "ENABLE_EXPERIMENTAL_COREPACK": "1"
  }
}
