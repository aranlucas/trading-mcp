{
  "extends": ["../../.oxlintrc.json"],
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "env": {
    "node": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/.expo/**",
    "**/.vercel/**",
    "**/.agent/**",
    "**/.agents/**",
    "**/.claude/**",
    "**/.codex/**",
    "**/.continue/**",
    "**/.cursor/**",
    "**/.gemini/**",
    "**/.opencode/**",
    "**/.pi/**",
    "**/.roo/**",
    "**/.windsurf/**"
  ],
  "overrides": [
    {
      "files": ["src/config.ts"],
      "rules": {
        "eslint/no-console": [
          "error",
          {
            "allow": ["error"]
          }
        ]
      }
    },
    {
      "files": ["src/providers/finviz.ts"],
      "rules": {
        "eslint/no-console": [
          "error",
          {
            "allow": ["error"]
          }
        ]
      }
    },
    {
      "files": ["src/lib/technicals.ts"],
      "rules": {
        "typescript/no-non-null-assertion": "off"
      }
    }
  ]
}
