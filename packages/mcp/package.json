{
  "name": "@trading/mcp",
  "version": "0.1.0",
  "description": "Trading MCP server for stock trading operations",
  "keywords": [
    "mcp",
    "stocks",
    "trading"
  ],
  "license": "MIT",
  "bin": {
    "trading-mcp": "./dist/index.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@trading/core": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
