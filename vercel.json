{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @trading/core build && pnpm --filter @trading/screener build",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    },
    "api/[...path].ts": {
      "maxDuration": 30
    }
  }
}

