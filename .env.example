# Alpaca Trading API (Required for trading features)
ALPACA_API_KEY=your-api-key-here
ALPACA_API_SECRET=your-api-secret-here
ALPACA_PAPER=true  # Use paper trading by default

# Optional - Additional data providers
POLYGON_API_KEY=optional-polygon-key
FINNHUB_API_KEY=optional-finnhub-key
FRED_API_KEY=optional-fred-key

# Server configuration (for local development)
PORT=3000

# Screener provider (defaults to "yahoo" if unset)
# "yahoo" = free, keyless market data (quotes + daily bars)
# "alpaca" = requires ALPACA_API_KEY / ALPACA_API_SECRET
SCREENER_PROVIDER=yahoo

# Telegram notifications (optional)
# Create a bot via @BotFather, then set these to send alerts
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_your_token_here
TELEGRAM_CHAT_ID=123456789
# Optional: for forum topics / threaded groups
TELEGRAM_MESSAGE_THREAD_ID=
